{
  "name": "2sides-data",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "Topic and tally data store for the 2 Sides app — daily batch generated by Claude, human-reviewed, served over raw.githubusercontent",
  "scripts": {
    "discover": "node scripts/pipeline/discover-topics.js",
    "generate": "node scripts/pipeline/generate-topics.js",
    "verify:sources": "node scripts/pipeline/verify-sources.js",
    "promote": "node scripts/pipeline/promote-topics.js",
    "seed:tallies": "node scripts/pipeline/seed-sample-tallies.js",
    "snapshot": "node scripts/pipeline/snapshot-tallies.js",
    "build:feed": "node scripts/pipeline/build-feed.js",
    "validate": "node scripts/pipeline/validate-data.js",
    "validate:fixtures": "node scripts/pipeline/validate-data.js --fixtures",
    "check": "npm run validate:fixtures && npm run validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
